# ===================================================================
# CinePass Production Environment Variables Example
# Duplicate this file as .env and update with your actual credentials
# ===================================================================

# Application Port (Render/Railway/Heroku inject this automatically)
PORT=3000
NODE_ENV=production

# -------------------------------------------------------------
# Option A: Single Connection URL (Standard on Render / Railway / Aiven)
# -------------------------------------------------------------
# DATABASE_URL=mysql://user:password@host:port/database?ssl=true
# MYSQL_URL=mysql://user:password@host:port/database

# -------------------------------------------------------------
# Option B: Individual MySQL Connection Parameters
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=movie_booking_db

# Set to true if connecting to a cloud-managed database requiring SSL (e.g. Aiven, PlanetScale, AWS RDS)
DB_SSL=false

